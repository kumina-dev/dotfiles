{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 0,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "custom/updates",
    "clock"
  ],

  "modules-right": [
    "hyprland/language",
    "bluetooth",
    "pulseaudio",
    "tray"
  ],

  "custom/updates": {
    "exec": "~/.config/hypr/scripts/update-check.sh",
    "return-type": "json",
    "interval": 900,
    "tooltip": true,
    "on-click": "kitty --class kumina-updater -e ~/.config/hypr/scripts/system-update.sh"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 55,
    "separate-outputs": true
  },

  "hyprland/language": {
    "format": "{}",
    "format-fi": "FI",
    "format-en": "EN"
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "on-click": "~/.config/hypr/scripts/calendar-toggle.sh"
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "",
    "tooltip-format": "{controller_alias}\n{device_enumerate}",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "speaker": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "tooltip-format": "{desc}\nVolume: {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 2
  },

  "tray": {
    "icon-size": 16,
    "spacing": 7
  }
}
